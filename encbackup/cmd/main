#!/bin/bash

# 加密备份 - 生命周期脚本（start/stop/status）

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
BUILTIN_DIR="${TRIM_APPDEST}/server"
APP_DIR="$BUILTIN_DIR"
OVERLAY="${TRIM_PKGVAR}/overlay"
GATEWAY_PREFIX="/app/encbackup"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"

mkdir -p "${TRIM_PKGVAR}" 2>/dev/null

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -n "$pid" ] && check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

# 版本比较：$1 > $2 时返回 0（依赖 GNU sort -V）
ver_gt() {
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" = "$1" ]
}

# 与 backend/updater.go 里 rollbackSh 保持一致
rollback_overlay() {
  local O="$OVERLAY" D="$TRIM_PKGVAR" V
  V="$(cat "$O/trial" 2>/dev/null)"
  if [ -L "$O/previous" ]; then ln -sfn "$(readlink "$O/previous")" "$O/current"; else rm -f "$O/current"; fi
  [ -n "$V" ] && [ -f "$O/config.pre-$V.json" ] && cp -f "$O/config.pre-$V.json" "$D/config.json"
  [ -n "$V" ] && echo "$V" > "$O/failed"
  rm -f "$O/trial" "$O/trial.booted"
  log_msg "Online update $V did not confirm, rolled back"
}

# 选择要启动的版本：热更新目录里的版本比商店内置版本新时优先用它
pick_app_dir() {
  BUILTIN_VERSION="$("${BUILTIN_DIR}/encbackup-server" --version 2>/dev/null | head -n 1)"
  [ -d "$OVERLAY" ] || return 0

  # 上一次以试运行版本启动后没能转正（崩溃/断电）：回滚
  if [ -f "$OVERLAY/trial" ]; then
    if [ -f "$OVERLAY/trial.booted" ]; then
      rollback_overlay
    else
      touch "$OVERLAY/trial.booted"
    fi
  fi

  local cur="$OVERLAY/current" ver
  [ -x "$cur/encbackup-server" ] || return 0
  ver="$(cat "$cur/VERSION" 2>/dev/null | tr -d '[:space:]')"
  if [ -n "$BUILTIN_VERSION" ] && ver_gt "$ver" "$BUILTIN_VERSION"; then
    APP_DIR="$cur"
    log_msg "Using online-updated version $ver (store version $BUILTIN_VERSION)"
  else
    # 商店已经升到同版本或更新：热更新目录作废
    log_msg "Store version $BUILTIN_VERSION >= online version $ver, clearing overlay"
    rm -rf "$OVERLAY"
  fi
}

start_app() {
  if status_app; then
    return 0
  fi
  pick_app_dir

  log_msg "Starting encbackup server..."
  if [ ! -x "${APP_DIR}/encbackup-server" ]; then
    echo "Server binary missing: ${APP_DIR}/encbackup-server" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi

  cd "$APP_DIR" || exit 1
  TRIM_APPDEST="$TRIM_APPDEST" \
  TRIM_PKGVAR="$TRIM_PKGVAR" \
  GATEWAY_PREFIX="$GATEWAY_PREFIX" \
  BUILTIN_VERSION="$BUILTIN_VERSION" \
  SOCKET_PATH="$SOCKET_PATH" \
    ./encbackup-server >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
  log_msg "Started with pid $(cat "$PID_FILE")"
}

stop_app() {
  log_msg "Stopping encbackup server..."

  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi

  local pid
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"

  if [ -z "$pid" ] || ! check_process "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi

  kill -TERM "$pid" 2>> "$LOG_FILE" || true

  local count=0
  while check_process "$pid" && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done

  if check_process "$pid"; then
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi

  rm -f "$PID_FILE"
  rm -f "$SOCKET_PATH"
  log_msg "Stopped."
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
