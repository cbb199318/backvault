#!/bin/bash

# 加密备份 - 生命周期脚本（start/stop/status）

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
APP_DIR="${TRIM_APPDEST}/server"
GATEWAY_PREFIX="/app/encbackup"
SOCKET_PATH="${TRIM_APPDEST}/app.sock"

mkdir -p "${TRIM_PKGVAR}" 2>/dev/null

log_msg() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
  local pid="$1"
  kill -0 "$pid" 2>/dev/null
}

status_app() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
    if [ -n "$pid" ] && check_process "$pid"; then
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  return 1
}

start_app() {
  if status_app; then
    return 0
  fi

  log_msg "Starting encbackup server..."
  if [ ! -x "${APP_DIR}/encbackup-server" ]; then
    echo "Server binary missing: ${APP_DIR}/encbackup-server" > "$TRIM_TEMP_LOGFILE"
    exit 1
  fi

  cd "$APP_DIR" || exit 1
  TRIM_APPDEST="$TRIM_APPDEST" \
  TRIM_PKGVAR="$TRIM_PKGVAR" \
  GATEWAY_PREFIX="$GATEWAY_PREFIX" \
  SOCKET_PATH="$SOCKET_PATH" \
    ./encbackup-server >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
  log_msg "Started with pid $(cat "$PID_FILE")"
}

stop_app() {
  log_msg "Stopping encbackup server..."

  if [ ! -f "$PID_FILE" ]; then
    return 0
  fi

  local pid
  pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"

  if [ -z "$pid" ] || ! check_process "$pid"; then
    rm -f "$PID_FILE"
    return 0
  fi

  kill -TERM "$pid" 2>> "$LOG_FILE" || true

  local count=0
  while check_process "$pid" && [ "$count" -lt 10 ]; do
    sleep 1
    count=$((count + 1))
  done

  if check_process "$pid"; then
    kill -KILL "$pid" 2>> "$LOG_FILE" || true
  fi

  rm -f "$PID_FILE"
  rm -f "$SOCKET_PATH"
  log_msg "Stopped."
}

case "$1" in
  start)
    start_app
    ;;
  stop)
    stop_app
    ;;
  status)
    if status_app; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
